FROM python:3.11-slim

WORKDIR /app

# Ставим системные утилиты для быстрой сборки PyStemmer
RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir langgraph llama-index-core llama-index-retrievers-bm25 PyStemmer openai

COPY . .

# Флаг -u нужен, чтобы консольный ввод/вывод (input/print) работал без задержек
CMD ["python", "-u", "brain.py"]
